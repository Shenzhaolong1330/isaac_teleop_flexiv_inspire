+void ManusTracker::initialize_ergonomics_output()
+{
+    const char* destination = std::getenv("ISAAC_TELEOP_MANUS_ERGONOMICS_UDP");
+    if (destination == nullptr || std::string(destination).empty())
+    {
+        return;
+    }
+
+#if defined(__linux__)
+    const std::string value(destination);
+    const auto separator = value.rfind(':');
+    if (separator == std::string::npos)
+    {
+        throw std::runtime_error("ISAAC_TELEOP_MANUS_ERGONOMICS_UDP must be HOST:PORT");
+    }
+    m_ergonomics_host = value.substr(0, separator);
+    if (m_ergonomics_host == "localhost")
+    {
+        m_ergonomics_host = "127.0.0.1";
+    }
+    if (m_ergonomics_host != "127.0.0.1")
+    {
+        throw std::runtime_error("MANUS Ergonomics UDP destination must be loopback");
+    }
+    try
+    {
+        const auto port = std::stoul(value.substr(separator + 1));
+        if (port == 0 || port > 65535)
+        {
+            throw std::out_of_range("port");
+        }
+        m_ergonomics_port = static_cast<uint16_t>(port);
+    }
+    catch (const std::exception&)
+    {
+        throw std::runtime_error("MANUS Ergonomics UDP port is invalid");
+    }
+    m_ergonomics_socket = socket(AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+    if (m_ergonomics_socket < 0)
+    {
+        throw std::runtime_error("Failed to create MANUS Ergonomics UDP socket");
+    }
+    std::cout << "[Manus] Ergonomics output enabled on " << m_ergonomics_host << ':' << m_ergonomics_port << std::endl;
+#else
+    throw std::runtime_error("MANUS Ergonomics UDP is currently supported on Linux only");
+#endif
+}
+
+void ManusTracker::close_ergonomics_output()
+{
+#if defined(__linux__)
+    if (m_ergonomics_socket >= 0)
+    {
+        close(m_ergonomics_socket);
+        m_ergonomics_socket = -1;
+    }
+#endif
 }
 
