+void ManusTracker::OnErgonomicsStream(const ErgonomicsStream* ergonomics_stream)
+{
+    auto& tracker = instance();
+    std::lock_guard<std::mutex> instance_lock(tracker.m_lifecycle_mutex);
+    if (!tracker.m_initialized || tracker.m_ergonomics_socket < 0 || ergonomics_stream == nullptr)
+    {
+        return;
+    }
+
+#if defined(__linux__)
+    sockaddr_in destination{};
+    destination.sin_family = AF_INET;
+    destination.sin_port = htons(tracker.m_ergonomics_port);
+    if (inet_pton(AF_INET, tracker.m_ergonomics_host.c_str(), &destination.sin_addr) != 1)
+    {
+        return;
+    }
+
+    for (uint32_t i = 0; i < ergonomics_stream->dataCount; ++i)
+    {
+        const auto& ergonomics = ergonomics_stream->data[i];
+        if (ergonomics.isUserID)
+        {
+            continue;
+        }
+        bool is_left = false;
+        bool is_right = false;
+        {
+            std::lock_guard<std::mutex> landscape_lock(tracker.landscape_mutex);
+            is_left = tracker.left_glove_id && ergonomics.id == *tracker.left_glove_id;
+            is_right = tracker.right_glove_id && ergonomics.id == *tracker.right_glove_id;
+        }
+        if (!is_left && !is_right)
+        {
+            continue;
+        }
+        const auto first = static_cast<size_t>(is_left ? ErgonomicsDataType_LeftFingerThumbMCPSpread :
+                                                         ErgonomicsDataType_RightFingerThumbMCPSpread);
+        constexpr size_t kFieldsPerSide = 20;
+        std::ostringstream packet;
+        packet << "MANUS_ERGONOMICS_V1," << (is_left ? "left" : "right") << ',' << ergonomics.id << ','
+               << ergonomics_stream->publishTime.time << std::setprecision(9);
+        for (size_t field = 0; field < kFieldsPerSide; ++field)
+        {
+            packet << ',' << ergonomics.data[first + field];
+        }
+        const auto payload = packet.str();
+        sendto(tracker.m_ergonomics_socket, payload.data(), payload.size(), MSG_DONTWAIT,
+               reinterpret_cast<const sockaddr*>(&destination), sizeof(destination));
+    }
+#endif
+}
